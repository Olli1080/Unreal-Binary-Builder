<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="UnrealBinaryBuilder.Avalonia.Views.UserControls.DownloadDialog"
        Title="Update Available" Width="600" Height="250"
        WindowStartupLocation="CenterOwner">
    <Border Padding="20" Background="{DynamicResource RegionBrush}">
        <StackPanel Spacing="10">
            <TextBlock x:Name="DownloadProgressTextBlock" Text="Downloading..." TextWrapping="Wrap" FontSize="14"/>
            <ProgressBar x:Name="DownloadProgressbar" HorizontalAlignment="Stretch" Height="20" Value="0" IsIndeterminate="True"/>
            
            <TextBlock Text="A new update is available. You can view the changelog online." Margin="0 10 0 0"/>
            <Button Content="View Changelog Online" HorizontalAlignment="Center" Click="ViewChangelog_Click" Theme="{StaticResource AccentButtonStyle}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0 20 0 0">
                <Button x:Name="DownloadNowBtn" Content="Download Update" Width="150" Click="DownloadNowBtn_Click"/>
                <Button x:Name="CancelBtn" Content="Cancel" Width="100" Click="CancelBtn_Click"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
